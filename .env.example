# Copie para .env.stage e .env.main e preencha (Supabase → Project Settings → API Keys).
# SUPABASE_ANON_KEY: use a chave publishable (sb_publishable_…).
# Só valores públicos: a chave anon vai para o navegador de qualquer jeito.
# Nunca coloque aqui a service_role / sb_secret nem tokens sbp_.
AMBIENTE=stage
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
ADMIN_EMAIL=admin@bigou.app
